{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/create", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/history", "destination": "/index.html" },
    { "source": "/generating/:id", "destination": "/index.html" },
    { "source": "/case/:id", "destination": "/index.html" },
    { "source": "/case/:id/:section", "destination": "/index.html" }
  ]
}
